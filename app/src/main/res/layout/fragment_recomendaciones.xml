<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/txtTituloRecomendaciones"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Recomendaciones sostenibles"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#1F2937"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtOds"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="ODS 9 — Industria, Innovación e Infraestructura"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#A11A5C"
        app:layout_constraintTop_toBottomOf="@id/txtTituloRecomendaciones"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtDescripcionOds"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="La innovación y la modernización de la infraestructura pueden ayudar a las empresas a mejorar su eficiencia y reducir su impacto ambiental."
        android:textSize="16sp"
        android:textColor="#374151"
        app:layout_constraintTop_toBottomOf="@id/txtOds"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtRecomendaciones"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="• Utilizar equipos de mayor eficiencia energética.\n\n• Modernizar maquinaria e infraestructura.\n\n• Incorporar tecnologías de energía limpia.\n\n• Optimizar el consumo eléctrico.\n\n• Medir periódicamente las emisiones de CO₂.\n\n• Promover procesos industriales más sostenibles."
        android:textSize="16sp"
        android:textColor="#1F2937"
        app:layout_constraintTop_toBottomOf="@id/txtDescripcionOds"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnRegresarInicioRecomendaciones"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Regresar al inicio"
        app:layout_constraintTop_toBottomOf="@id/txtRecomendaciones"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>